# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 주소 (이메일 인증 리다이렉트, 추천 링크)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 결제 체인 (EVM) ─────────────────────────────────────
# 1=Ethereum, 11155111=Sepolia, 137=Polygon, 80002=Polygon Amoy, 56=BSC, 97=BSC Testnet, 8453=Base, 42161=Arbitrum
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
# 결제받을 스테이블코인(ERC-20) 컨트랙트 주소와 소수 자릿수 (USDT: ETH/Polygon=6, BSC=18)
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=6
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=USDT
# 판매 대금을 받을 회사 지갑
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# 결제 확정에 필요한 블록 확인 수
PAYMENT_MIN_CONFIRMATIONS=3

# ── 정산 크론 (Vercel이 Authorization: Bearer 로 자동 전송) ──
CRON_SECRET=change-me-long-random-string

# 출금 최소 금액
NEXT_PUBLIC_MIN_WITHDRAWAL=10
